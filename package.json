{
  "name": "orbit-project-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "test:mongo": "node scripts/test-mongo.mjs",
    "format": "prettier --write src server shared scripts tests vite.config.js",
    "format:check": "prettier --check src server shared scripts tests vite.config.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.20.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "mongodb-memory-server-core": "^10.2.0",
    "prettier": "3.6.2",
    "vite": "^7.1.12"
  }
}
